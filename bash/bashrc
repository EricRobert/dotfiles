# ~/.bashrc: executed by bash(1) for non-login shells.

# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc) for examples.

# if not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# run /etc/bashrc if it exists
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

HISTCONTROL=ignoredups:ignorespace
HISTSIZE=4096

shopt -s histappend
shopt -s checkwinsize

export TERM=xterm-256color

alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias df='df -kTh'
alias du='du -kh'
alias ll='ls -al'

PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

export GOPATH=$HOME/.go
export PATH=$GOPATH/bin:$HOME/.local/bin:/usr/local/go/bin:$PATH

# ssh binds SSH_AUTH_SOCK to a socket it makes for one login and removes at
# logout, so a shell outliving that login - a reattached tmux pane, a shell
# resumed after the laptop slept - holds a path nothing listens on. The link
# below is repointed by each login and named by every shell, so one path reaches
# whichever agent is current. Relinked only from a real socket, which is what ssh
# hands a fresh login and never what this exports.
if [ -S "$SSH_AUTH_SOCK" ] && [ ! -h "$SSH_AUTH_SOCK" ]; then
    mkdir -p "$HOME/.ssh"
    ln -sf "$SSH_AUTH_SOCK" "$HOME/.ssh/agent.sock"
fi

if [ -h "$HOME/.ssh/agent.sock" ]; then
    export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
fi

fixssh() {
    if [ -z "$TMUX" ]; then
        echo "fixssh: not in a tmux session" >&2
        return 1
    fi

    eval "$(tmux show-environment -s SSH_AUTH_SOCK)"
}
