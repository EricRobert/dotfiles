setopt CORRECT
setopt EXTENDED_GLOB
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS

# History

HISTSIZE=20000
SAVEHIST=20000
HISTFILE=~/.zsh_history

setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_REDUCE_BLANKS

# Completion

fpath=(~/.zsh/completions $fpath)
autoload -Uz compinit
compinit

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.zsh/cache

# Colors

export CLICOLOR=1
export LSCOLORS=ExFxCxDxBxegedabagacad

# Commands

alias ls='ls -G'
alias ll='ls -lah'

# Prompt

autoload -U colors && colors
setopt PROMPT_SUBST

PROMPT='%F{cyan}%n@%m%f %F{yellow}%~%f %# '

# Key bindings

bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^R' history-incremental-search-backward

# Environment

export GOPATH="$HOME/.go"
export PATH="$GOPATH/bin:$HOME/.local/bin:$PATH"

# ssh binds SSH_AUTH_SOCK to a socket it makes for one login and removes at
# logout, so a shell outliving that login - a reattached tmux pane, a shell
# resumed after the laptop slept - holds a path nothing listens on. The link
# below is repointed by each login and named by every shell, so one path reaches
# whichever agent is current. Relinked only from a real socket, which is what ssh
# hands a fresh login and never what this exports.
if [ -S "$SSH_AUTH_SOCK" ] && [ ! -h "$SSH_AUTH_SOCK" ]; then
    mkdir -p "$HOME/.ssh"
    ln -sf "$SSH_AUTH_SOCK" "$HOME/.ssh/agent.sock"
fi

if [ -h "$HOME/.ssh/agent.sock" ]; then
    export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
fi

# Functions

fixssh() {
    if [ -z "$TMUX" ]; then
        echo "fixssh: not in a tmux session" >&2
        return 1
    fi

    eval "$(tmux show-environment -s SSH_AUTH_SOCK)"
}
